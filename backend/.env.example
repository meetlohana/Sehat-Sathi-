# Copy to .env and fill in. NEVER commit .env
APP_ENV=development
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
# Comma separated. Use your real domains in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
# Central PostgreSQL (used by your real PatientRepository implementation)
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/sehat_sathi
# Optional LLM fallback (disabled by default; not needed for simple commands)
LLM_ENABLED=false
